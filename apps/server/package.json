{
  "name": "@impulso/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "start": "node scripts/migrate.mjs && tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@colyseus/core": "0.18.15",
    "@colyseus/ws-transport": "0.18.2",
    "@impulso/input": "workspace:*",
    "@impulso/sim": "workspace:*",
    "@impulso/state": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.3",
    "@types/pg": "8.23.1"
  }
}
