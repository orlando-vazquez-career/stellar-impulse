{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Identidad táctica espacial para un RTS isométrico de navegador: precisión de consola, energía de propulsión y lectura inmediata del campo.",
  "color": {
    "$type": "color",
    "primary": {"$value": {"colorSpace": "srgb", "components": [0.212, 0.663, 1], "hex": "#36a9ff"}},
    "secondary": {"$value": {"colorSpace": "srgb", "components": [0.443, 0.898, 0.863], "hex": "#71e5dc"}},
    "tertiary": {"$value": {"colorSpace": "srgb", "components": [1, 0.847, 0.302], "hex": "#ffd84d"}},
    "space": {"$value": {"colorSpace": "srgb", "components": [0.027, 0.043, 0.078], "hex": "#070b14"}},
    "space-deep": {"$value": {"colorSpace": "srgb", "components": [0.012, 0.027, 0.047], "hex": "#03070c"}},
    "surface": {"$value": {"colorSpace": "srgb", "components": [0.075, 0.114, 0.176], "hex": "#131d2d"}},
    "surface-raised": {"$value": {"colorSpace": "srgb", "components": [0.125, 0.18, 0.263], "hex": "#202e43"}},
    "border": {"$value": {"colorSpace": "srgb", "components": [0.227, 0.29, 0.384], "hex": "#3a4a62"}},
    "text": {"$value": {"colorSpace": "srgb", "components": [0.949, 0.965, 0.98], "hex": "#f2f6fa"}},
    "muted": {"$value": {"colorSpace": "srgb", "components": [0.576, 0.643, 0.722], "hex": "#93a4b8"}},
    "signal": {"$value": {"colorSpace": "srgb", "components": [0.443, 0.898, 0.863], "hex": "#71e5dc"}},
    "blue-faction": {"$value": {"colorSpace": "srgb", "components": [0.212, 0.663, 1], "hex": "#36a9ff"}},
    "red-faction": {"$value": {"colorSpace": "srgb", "components": [1, 0.31, 0.392], "hex": "#ff4f64"}},
    "neutral": {"$value": {"colorSpace": "srgb", "components": [0.663, 0.471, 1], "hex": "#a978ff"}},
    "energy": {"$value": {"colorSpace": "srgb", "components": [1, 0.847, 0.302], "hex": "#ffd84d"}},
    "success": {"$value": {"colorSpace": "srgb", "components": [0.29, 0.839, 0.604], "hex": "#4ad69a"}},
    "warning": {"$value": {"colorSpace": "srgb", "components": [1, 0.624, 0.263], "hex": "#ff9f43"}},
    "metal": {"$value": {"colorSpace": "srgb", "components": [0.749, 0.788, 0.839], "hex": "#bfc9d6"}},
    "core": {"$value": {"colorSpace": "srgb", "components": [0.969, 0.906, 0.486], "hex": "#f7e77c"}}
  },
  "spacing": {
    "$type": "dimension",
    "xs": {"$value": {"value": 4, "unit": "px"}},
    "sm": {"$value": {"value": 8, "unit": "px"}},
    "md": {"$value": {"value": 16, "unit": "px"}},
    "lg": {"$value": {"value": 24, "unit": "px"}},
    "xl": {"$value": {"value": 32, "unit": "px"}},
    "section": {"$value": {"value": 40, "unit": "px"}}
  },
  "rounded": {
    "$type": "dimension",
    "none": {"$value": {"value": 0, "unit": "px"}},
    "sm": {"$value": {"value": 2, "unit": "px"}},
    "md": {"$value": {"value": 8, "unit": "px"}},
    "pill": {"$value": {"value": 999, "unit": "px"}}
  },
  "typography": {
    "display": {"$type": "typography", "$value": {"fontFamily": "Rajdhani", "fontSize": {"value": 1.25, "unit": "rem"}, "fontWeight": 700, "letterSpacing": {"value": 0.06, "unit": "em"}}},
    "body": {"$type": "typography", "$value": {"fontFamily": "Inter", "fontSize": {"value": 1, "unit": "rem"}, "fontWeight": 400}},
    "label": {"$type": "typography", "$value": {"fontFamily": "Rajdhani", "fontSize": {"value": 0.75, "unit": "rem"}, "fontWeight": 600, "letterSpacing": {"value": 0.14, "unit": "em"}}},
    "numeric": {"$type": "typography", "$value": {"fontFamily": "Rajdhani", "fontSize": {"value": 1.375, "unit": "rem"}, "fontWeight": 600}}
  }
}
